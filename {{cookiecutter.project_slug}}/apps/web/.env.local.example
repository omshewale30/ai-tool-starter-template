# Frontend environment (copy to .env.local).
# Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

# Backend base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local dev: bypass MSAL entirely (pairs with backend AUTH_MODE=disabled).
# Set to "false" to exercise real Microsoft Entra ID sign-in.
NEXT_PUBLIC_AUTH_DISABLED=true

# Microsoft Entra ID (SPA app registration).
NEXT_PUBLIC_ENTRA_CLIENT_ID={{ cookiecutter.frontend_client_id }}
NEXT_PUBLIC_ENTRA_TENANT_ID={{ cookiecutter.entra_tenant_id }}
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000

# Scope requested for the backend API (exposed on the backend app registration).
NEXT_PUBLIC_ENTRA_API_SCOPE={{ cookiecutter.backend_app_id_uri }}/access_as_user
