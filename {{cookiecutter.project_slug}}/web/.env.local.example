# Frontend environment for `npm run dev` (copy to .env.local).
#
# These are read at RUNTIME by the server (no NEXT_PUBLIC_ prefix), so one built
# image works in every environment. None of them are secrets.

# Where the Next.js server forwards /api/* (the FastAPI backend).
BACKEND_ORIGIN=http://127.0.0.1:8000

# Microsoft Entra ID: the web (SPA) app registration and the API scope it requests.
ENTRA_CLIENT_ID={{ cookiecutter.frontend_client_id }}
ENTRA_TENANT_ID={{ cookiecutter.entra_tenant_id }}
ENTRA_API_SCOPE={{ cookiecutter.backend_app_id_uri }}/access_as_user

# Local development only: skip Entra sign-in (pairs with the API's AUTH_MODE=disabled).
# Build-time on purpose, so a published image can never have auth switched off.
NEXT_PUBLIC_AUTH_DISABLED=true
