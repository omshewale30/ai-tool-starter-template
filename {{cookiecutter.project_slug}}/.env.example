# =============================================================================
# {{ cookiecutter.project_name }} — environment configuration (example)
# Copy to `.env` for docker-compose / local development.
# DO NOT put real secrets in this file or in `.env`. Use Key Vault in Azure.
# =============================================================================

# ---- Core / runtime ---------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Backend: AI provider ---------------------------------------------------
# `mock` requires no Azure resources and is the default for local dev/tests.
# `foundry` calls Azure AI Foundry via the backend service layer.
AI_PROVIDER=mock

# ---- Backend: authentication ------------------------------------------------
# `disabled` => JWT validation is bypassed. LOCAL DEVELOPMENT ONLY. Never deploy
# with this. The backend logs a warning on every request when disabled.
# `entra`    => validate Microsoft Entra ID access tokens.
AUTH_MODE=disabled

AZURE_TENANT_ID={{ cookiecutter.entra_tenant_id }}
ENTRA_BACKEND_CLIENT_ID={{ cookiecutter.backend_client_id }}
ENTRA_BACKEND_APP_ID_URI={{ cookiecutter.backend_app_id_uri }}
# Group object id (or app role) that grants access to /api/v1/admin/*
ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000

# ---- Backend: database ------------------------------------------------------
# docker-compose's PostgreSQL (`make dev` / `make up`). Migrations run at API
# startup in containers; run `make migrate` when running the API natively.
# Tests use in-memory SQLite. In Azure, DATABASE_URL comes from Key Vault.
POSTGRES_PASSWORD=localdev
DATABASE_URL=postgresql+psycopg://app:localdev@127.0.0.1:5432/appdb

# ---- Backend: Azure OpenAI / AI Foundry (only when AI_PROVIDER=foundry) ------
# UNC's Azure-hosted models. Keyless: locally this uses your `az login` identity,
# in Azure the container app's managed identity (see docs/ai.md).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=
AZURE_AI_FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# ---- Backend: Azure Blob Storage (optional locally) -------------------------
# Leave blank locally; in Azure this is resolved via managed identity.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=uploads

# ---- Backend: Azure AI Search (optional) ------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=default

# ---- Frontend (read at runtime by the Next.js server; see web/.env.local.example)
BACKEND_ORIGIN=http://127.0.0.1:8000
ENTRA_CLIENT_ID={{ cookiecutter.frontend_client_id }}
ENTRA_TENANT_ID={{ cookiecutter.entra_tenant_id }}
ENTRA_API_SCOPE={{ cookiecutter.backend_app_id_uri }}/access_as_user
# Local development only: skip Entra sign-in (pairs with AUTH_MODE=disabled).
NEXT_PUBLIC_AUTH_DISABLED=true
