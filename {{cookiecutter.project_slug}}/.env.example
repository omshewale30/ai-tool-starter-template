# =============================================================================
# {{ cookiecutter.project_name }} — environment configuration (example)
# Copy to `.env` for docker-compose / local development.
# DO NOT put real secrets in this file or in `.env`. Use Key Vault in Azure.
# =============================================================================

# ---- Core / runtime ---------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Backend: AI provider ---------------------------------------------------
# `mock` requires no Azure resources and is the default for local dev/tests.
# `foundry` calls Azure AI Foundry via the backend service layer.
AI_PROVIDER=mock

# ---- Backend: authentication ------------------------------------------------
# `disabled` => JWT validation is bypassed. LOCAL DEVELOPMENT ONLY. Never deploy
# with this. The backend logs a warning on every request when disabled.
# `entra`    => validate Microsoft Entra ID access tokens.
AUTH_MODE=disabled

AZURE_TENANT_ID={{ cookiecutter.entra_tenant_id }}
ENTRA_BACKEND_CLIENT_ID={{ cookiecutter.backend_client_id }}
ENTRA_BACKEND_APP_ID_URI={{ cookiecutter.backend_app_id_uri }}
# Group object id (or app role) that grants access to /api/v1/admin/*
ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000

# ---- Backend: CORS ----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- Backend: database ------------------------------------------------------
# Local dev via docker-compose uses SQL Server `master` (migrations run at API startup).
# Tests use in-memory SQLite.
# Example Azure SQL URL (managed identity / access token auth handled in code):
#   mssql+pyodbc://<server>.database.windows.net/<db>?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=mssql+pyodbc://sa:Your_password123@db:1433/master?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SQL_SA_PASSWORD=Your_password123

# ---- Backend: Azure AI Foundry (only needed when AI_PROVIDER=foundry) --------
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_PROJECT_NAME={{ cookiecutter.project_slug }}
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_AI_FOUNDRY_API_VERSION=2024-08-01-preview

# ---- Backend: Azure Blob Storage (optional locally) -------------------------
# Leave blank locally; in Azure this is resolved via managed identity.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=uploads

# ---- Backend: Azure AI Search (optional) ------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=default

# ---- Frontend (also see apps/web/.env.local.example) ------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENTRA_CLIENT_ID={{ cookiecutter.frontend_client_id }}
NEXT_PUBLIC_ENTRA_TENANT_ID={{ cookiecutter.entra_tenant_id }}
NEXT_PUBLIC_ENTRA_API_SCOPE={{ cookiecutter.backend_app_id_uri }}/access_as_user
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000
# Set to "true" to bypass MSAL in the UI for local dev (pairs with AUTH_MODE=disabled)
NEXT_PUBLIC_AUTH_DISABLED=true
